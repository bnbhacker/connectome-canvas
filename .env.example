# Connectome Canvas — nothing here is a private key, and nothing here is read
# unless the studio is started with minting armed (CANVAS_MINT=1).
#
# The painter's key lives ONLY in an encrypted keystore outside the repo:
#     python run.py wallet new          -> ~/.connectome-canvas/keystore.json
# The passphrase is asked for on the terminal. For unattended runs put it in a
# file and point CANVAS_KEYSTORE_PASSWORD_FILE at it — never in this file.

# --- brain ---------------------------------------------------------------
# CANVAS_GRAPH=build/graph.npz         # default: build/graph.npz, else build/surrogate.npz
CANVAS_TICKS=600                       # windows per sitting (10 ms of brain time each)
CANVAS_TICK_MS=10
CANVAS_PAUSE_S=20                      # pause between sittings
CANVAS_PORT=4660

# --- chain (Base) ----------------------------------------------------------
CANVAS_NETWORK=base                    # base | base-sepolia
# CANVAS_RPC=https://mainnet.base.org
# CANVAS_CONTRACT=0x...                # from `forge script contracts/script/Deploy.s.sol`
CANVAS_MINT=0                          # 1 = pin + mint every finished sitting (refused on a surrogate graph)
# CANVAS_LIST_ETH=0.02                 # if set, list each minted piece on OpenSea at this price
# CANVAS_KEYSTORE=~/.connectome-canvas/keystore.json
# CANVAS_KEYSTORE_PASSWORD_FILE=

# --- services --------------------------------------------------------------
# CANVAS_PINATA_JWT=                   # pinata.cloud API JWT (pins PNG + metadata)
# OPENSEA_API_KEY=                     # needed only for listings (tools/list.mjs)
# CANVAS_SITE_URL=https://connectomecanvas.art
