# Connectome Canvas — nothing here is a private key.
#
# The painter's key lives ONLY in an encrypted keystore outside the repo:
#     python run.py wallet new          -> ~/.connectome-canvas/keystore.json
# The passphrase is asked for on the terminal. For unattended runs put it in a
# file and point CANVAS_KEYSTORE_PASSWORD_FILE at it — never in this file.

# --- brain ---------------------------------------------------------------
# CANVAS_GRAPH=build/graph.npz         # default: build/graph.npz, else build/surrogate.npz
CANVAS_TICKS=600                       # windows per sitting (10 ms of brain time each)
CANVAS_TICK_MS=10
CANVAS_PAUSE_S=20                      # pause between sittings
CANVAS_SITTINGS=0                      # 0 = paint forever; 1 = paint one sitting, then rest
CANVAS_PORT=4660

# --- chain -------------------------------------------------------------------
CANVAS_NETWORK=robinhood               # Robinhood Chain, id 4663 — the only network
# CANVAS_RPC=https://rpc.mainnet.chain.robinhood.com
# CANVAS_CONTRACT=0x...                # from `python run.py deploy --live`
# CANVAS_OWNER=0x...                   # who receives minted tokens (default: the painter); your wallet, to list by hand
CANVAS_METADATA=site                   # site = image + JSON served from connectomecanvas.com/nft/ ; ipfs = Pinata
CANVAS_SITE_URL=https://connectomecanvas.com
CANVAS_MINT=0                          # 1 = the studio mints every finished sitting itself (default: by hand with run.py mint)
# CANVAS_LIST_ETH=0.02                 # optional: auto-list through tools/list.mjs (needs OPENSEA_API_KEY)
# CANVAS_KEYSTORE=~/.connectome-canvas/keystore.json
# CANVAS_KEYSTORE_PASSWORD_FILE=

# --- optional services -----------------------------------------------------
# CANVAS_PINATA_JWT=                   # only for CANVAS_METADATA=ipfs
# OPENSEA_API_KEY=                     # only for CLI listings; listing by hand on opensea.io needs nothing
