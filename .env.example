# Connectome Canvas — nothing here is a private key.
#
# The painter's key lives ONLY in an encrypted keystore outside the repo:
#     python run.py wallet new          -> ~/.connectome-canvas/keystore.json
# The passphrase is asked for on the terminal. For unattended runs put it in a
# file and point CANVAS_KEYSTORE_PASSWORD_FILE at it — never in this file.

# --- brain ---------------------------------------------------------------
# CANVAS_GRAPH=build/graph.npz         # default: build/graph.npz, else build/surrogate.npz
CANVAS_TICKS=600                       # windows per sitting (10 ms of brain time each)
CANVAS_TICK_MS=10
CANVAS_PAUSE_S=20                      # pause between sittings
CANVAS_SITTINGS=0                      # 0 = paint forever; 1 = paint one sitting, then rest
CANVAS_PORT=4660

# --- chain -------------------------------------------------------------------
CANVAS_NETWORK=robinhood               # Robinhood Chain, id 4663 — the only network
# CANVAS_RPC=https://rpc.mainnet.chain.robinhood.com
CANVAS_MAX_SUPPLY=5000                 # contract cap and the studio's stopping point
# CANVAS_OWNER=0x...                   # the keeper: owns the contract, manages the collection, receives royalties + sweeps
# CANVAS_CONTRACT=0x...                # from `python run.py deploy --live`
# CANVAS_MINT_TO=0x...                 # where minted tokens land (default: the painter, so it can list them itself)
CANVAS_METADATA=site                   # site = image + JSON served from connectomecanvas.com/nft/<id> ; ipfs = Pinata
CANVAS_SITE_URL=https://connectomecanvas.com
CANVAS_MINT=0                          # 1 = the studio mints every finished sitting itself
# CANVAS_LIST_ETH=0.005                # 1 + this = the studio lists every minted piece on OpenSea at this price
# CANVAS_KEYSTORE=~/.connectome-canvas/keystore.json
# CANVAS_KEYSTORE_PASSWORD_FILE=       # passphrase file OUTSIDE the repo, for unattended minting

# --- services ------------------------------------------------------------------
# OPENSEA_API_KEY=                     # needed for automatic listings (free: docs.opensea.io → API keys)
# CANVAS_PINATA_JWT=                   # only for CANVAS_METADATA=ipfs
# Seaport / OpenSea plumbing on Robinhood Chain, read from live fills; override only if OpenSea moves:
# CANVAS_CONDUIT_KEY=0x61159fefdfada89302ed55f8b9e89e2d67d8258712b3a3f89aa88525877f1d5e
# CANVAS_CONDUIT=0x963F00d3ff000064fFCbA824b800c0000000C300
# CANVAS_ZONE=0x000056F7000000EcE9003ca63978907a00FFD100
# CANVAS_OPENSEA_FEE_PCT=1.0
# CANVAS_ROYALTY_PCT=5.0
