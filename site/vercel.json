{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://studio.connectomecanvas.com/api/:path*" },
    { "source": "/gallery/:path*", "destination": "https://studio.connectomecanvas.com/gallery/:path*" }
  ],
  "headers": [
    { "source": "/recordings/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/(.*)\\.(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
